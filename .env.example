# ================================================
# Halo Apex - Configuration
# ================================================

# Execution guard: LOCAL_ONLY = local models only, no remote egress
HALO_EXECUTION_MODE=LOCAL_ONLY

# --- Halo Vector (embeddings + vector storage) ---
HALO_VECTOR_BASE_URL=http://localhost:11434/v1
HALO_VECTOR_EMBEDDING_MODEL=bge-m3
HALO_VECTOR_PERSIST_DIR=./halo_chroma_db

# --- Halo Blade (agent orchestration + LLM endpoint) ---
HALO_BLADE_LLM_URL=http://localhost:1234/v1
# Empty = auto-detect first non-embedding model on the endpoint
HALO_BLADE_LLM_MODEL=

# --- Halo Stream (optional SSD/RAM/VRAM paging interface) ---
USE_HALO_STREAM=False
# Only used when USE_HALO_STREAM=True
HALO_STREAM_BACKEND_URL=http://localhost:1234/v1

# --- Misc ---
HALO_MAX_LOG_LINES=50